# The scene depends on React 19.2.x specifically: @react-three/fiber's peer range
# is `>=19 <19.3`, so npm's default peer resolution rejects React 19.3. Pinning the
# resolution mode here means `npm install` and `npm ci` behave identically for
# anyone who clones the repo, instead of failing with ERESOLVE on a fresh machine.
legacy-peer-deps=true
